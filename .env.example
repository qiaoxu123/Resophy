# ============================================================
# Resophy Environment Configuration
# Copy to .env and fill in actual values
# ============================================================

# --- Resophy MySQL Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=resophy
DB_USER=resophy
DB_PASSWORD=your_resophy_db_password
DB_POOL_SIZE=5

# --- Flarum Database (for user authentication) ---
FLARUM_DB_HOST=127.0.0.1
FLARUM_DB_PORT=3306
FLARUM_DB_NAME=flarum_kyrfa5
FLARUM_DB_USER=flarum_2jESjY
FLARUM_DB_PASSWORD=your_flarum_db_password
FLARUM_DB_PREFIX=flarum_
FLARUM_API_URL=http://localhost:8000

# --- Redis (optional, for session cache) ---
REDIS_URL=redis://localhost:6379/1

# --- App ---
SECRET_KEY=change-me-to-a-random-string
RESOPHY_HOST=0.0.0.0
RESOPHY_PORT=7191
PAPERS_DIR=./papers
RESOPHY_DEBUG=false
